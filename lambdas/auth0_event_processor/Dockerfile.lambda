# CDK-compatible Lambda Dockerfile for auth0-event-processor
# Build context: workspace root (driver-ai-app/)
# Usage: docker build -f lambdas/auth0_event_processor/Dockerfile.lambda -t auth0-event-processor-lambda .

FROM ghcr.io/astral-sh/uv:0.9 AS uv

# Export stage: generate requirements from workspace lockfile
FROM python:3.12-slim AS exporter

COPY --from=uv /uv /bin/uv

WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY lambdas/auth0_event_processor/pyproject.toml lambdas/auth0_event_processor/pyproject.toml

# Export only auth0-event-processor's dependencies (not the whole workspace)
RUN uv export --package auth0-event-processor --frozen --no-dev --no-emit-workspace \
    -o /requirements.txt

# Builder stage: install dependencies into Lambda task root
FROM public.ecr.aws/lambda/python:3.12 AS builder

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

COPY --from=uv /uv /bin/uv
COPY --from=exporter /requirements.txt /requirements.txt

RUN uv pip install --no-cache --target "${LAMBDA_TASK_ROOT}" -r /requirements.txt

# Runtime stage: minimal image with deps + source
FROM public.ecr.aws/lambda/python:3.12

COPY --from=builder ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Copy Lambda source
COPY lambdas/auth0_event_processor/src ${LAMBDA_TASK_ROOT}/src

CMD ["src.main.handler"]
