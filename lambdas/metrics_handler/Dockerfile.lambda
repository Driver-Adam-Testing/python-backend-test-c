# CDK-compatible Lambda Dockerfile for metrics-handler
# Build context: workspace root (driver-ai-app/)
# Usage: docker build -f lambdas/metrics_handler/Dockerfile.lambda -t metrics-handler-lambda .

FROM ghcr.io/astral-sh/uv:0.9.25 AS uv

# Export stage: generate requirements from workspace lockfile
FROM python:3.12-slim AS exporter

COPY --from=uv /uv /bin/uv

WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY packages/driver_db/pyproject.toml packages/driver_db/pyproject.toml
COPY lambdas/metrics_handler/pyproject.toml lambdas/metrics_handler/pyproject.toml

# Export only metrics-handler's dependencies (not the whole workspace)
RUN uv export --package metrics-handler --frozen --no-dev --no-emit-workspace \
    -o /requirements.txt

# Builder stage: install dependencies into Lambda task root
FROM public.ecr.aws/lambda/python:3.12 AS builder

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

COPY --from=uv /uv /bin/uv
COPY --from=exporter /requirements.txt /requirements.txt

RUN uv pip install --no-cache --target "${LAMBDA_TASK_ROOT}" -r /requirements.txt

# Runtime stage: minimal image with deps + source
FROM public.ecr.aws/lambda/python:3.12

COPY --from=builder ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Copy workspace package (database) and Lambda source
COPY packages/driver_db/database ${LAMBDA_TASK_ROOT}/database
COPY lambdas/metrics_handler/src ${LAMBDA_TASK_ROOT}/src

CMD ["src.main.handler"]
